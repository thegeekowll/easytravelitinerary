# ==========================================
# REQUIRED — docker-compose will refuse to start without these
# ==========================================

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=

# ==========================================
# OPTIONAL — Admin account (first boot only)
# ==========================================
# If left empty, a random 16-char password is generated and printed to logs.
# You MUST read it from `docker-compose logs backend` on first startup.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=admin@travelagency.com

# ==========================================
# APPLICATION
# ==========================================
# Comma-separated origins, e.g. https://yourdomain.com,https://www.yourdomain.com
BACKEND_CORS_ORIGINS=

# URLs — replace with your actual domain or IP
FRONTEND_URL=http://your-domain-or-ip
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://your-domain-or-ip

# ==========================================
# EXTERNAL SERVICES (optional)
# ==========================================
SENDGRID_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=travel-agency-files
